# MarketingOS 2.0 - Environment Variables
# Copy this to .env and fill in your values

# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
BRAVE_API_KEY=your_brave_api_key

# Google Cloud (shared for GA4, Search Console, Google Ads)
GOOGLE_SERVICE_ACCOUNT_JSON=google_service_account.json
GA4_PROPERTY_ID=your_ga4_property_id
SEARCH_CONSOLE_SITE_URL=https://your-site.com
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token

# HubSpot CRM
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token

# DataForSEO
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password

# WordPress
WORDPRESS_URL=https://your-wordpress-site.com
WORDPRESS_USERNAME=your_wp_username
WORDPRESS_APP_PASSWORD=your_wp_application_password

# New AI Providers (Multi-Provider Router — all FREE)
OPENROUTER_API_KEY=your_openrouter_api_key
NVIDIA_API_KEY=your_nvidia_nim_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
SERPER_API_KEY=your_serper_api_key
